# Développement : l'URL de l'API (dépôt blaito) vers laquelle Vite relaie /api et /uploads.
VITE_API_PROXY=http://localhost:3000

# Production : laisser vide si l'API est servie sur le même domaine (/api/v1, relayé par nginx),
# sinon l'URL complète, par ex. https://api.laito.app/api/v1
VITE_API_URL=
